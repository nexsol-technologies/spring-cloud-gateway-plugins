<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ch.nexsol-tech.gateway</groupId>
		<artifactId>sample-gateways</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml </relativePath>
	</parent>
	<artifactId>sample-gateway-metrics</artifactId>
	<name>sample-gateway-metrics</name>
	<description>Gateway sample exercising spring-cloud-gateway-metrics and its sources</description>

	<dependencies>
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-metrics-core</artifactId>
			<version>${revision}</version>
		</dependency>
		<!--
			The three consolidating sources, so a single sample can switch between them
			with a profile. Each activates on metrics.provider; with none selected the
			core source reports the figures of this instance only.
		-->
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-metrics-prometheus</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-metrics-redis</artifactId>
			<version>${revision}</version>
		</dependency>
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-metrics-discovery</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- The traffic view the figures are plotted in. -->
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-ui</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- Publishes /actuator/prometheus, which the prometheus source reads back. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>
		<!-- The registry the discovery source lists the sibling instances from. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
		</dependency>
	</dependencies>

</project>
