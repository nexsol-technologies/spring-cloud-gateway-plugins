{
  "realm": "gateway",
  "enabled": true,
  "displayName": "Gateway console",
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginTheme": "keycloak",
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Reaches the gateway console"
      },
      {
        "name": "READER",
        "description": "Signs in, but is turned away by required-roles"
      }
    ]
  },
  "users": [
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ops",
      "lastName": "Operator",
      "email": "operator@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "operator",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    },
    {
      "username": "visitor",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Vic",
      "lastName": "Visitor",
      "email": "visitor@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "visitor",
          "temporary": false
        }
      ],
      "realmRoles": [
        "READER"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "gateway-console",
      "name": "Gateway console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "gateway-console-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8213/login/oauth2/code/keycloak"
      ],
      "webOrigins": [
        "http://localhost:8213"
      ],
      "attributes": {
        "post.logout.redirect.uris": "http://localhost:8213/ui/login*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}
