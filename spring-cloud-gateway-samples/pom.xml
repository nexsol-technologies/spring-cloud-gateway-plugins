<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ch.nexsol-tech.gateway</groupId>
		<artifactId>spring-cloud-gateway-plugins</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml </relativePath>
	</parent>
	<artifactId>spring-cloud-gateway-samples</artifactId>
	<name>spring-cloud-gateway-samples</name>
	<description>Samples for spring-cloud-gateway-plugins</description>
	<packaging>pom</packaging>

	<properties>
		<java.version>25</java.version>
		<maven.deploy.skip>true</maven.deploy.skip>
		<skipPublishing>true</skipPublishing>
		<gpg.skip>true</gpg.skip>
		<maven.source.skip>true</maven.source.skip>
		<maven.javadoc.skip>true</maven.javadoc.skip>
	</properties>

    <modules>
        <module>gateway</module>
        <module>service-a</module>
        <module>service-b</module>
        <module>eureka</module>
        <module>config-server</module>
        <module>auth-server</module>
    </modules>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
</project>
