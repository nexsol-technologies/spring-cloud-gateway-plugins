<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>ch.nexsol-tech.gateway</groupId>
		<artifactId>spring-cloud-gateway-plugins</artifactId>
		<version>${revision}</version>
		<relativePath>../pom.xml </relativePath>
	</parent>
	<artifactId>spring-cloud-gateway-ui</artifactId>
	<name>spring-cloud-gateway-ui</name>
	<description>Plugin exposing a Spring Boot Admin-like web UI shell for Spring Cloud Gateway</description>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webflux</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-thymeleaf</artifactId>
		</dependency>
		<!-- Optional: the traffic view reads gateway request metrics from the
		     MeterRegistry when Micrometer is on the classpath. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-core</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Optional: the routes and route tester views read the gateway route
		     definitions and route table. Always present in a gateway application. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-gateway-server-webflux</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Optional: the instances view names the routes a connection pool serves, which
		     for a load-balanced route is only known to the service registry. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-commons</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Optional: the audit view tails the events produced by the audit plugin. -->
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-audit-core</artifactId>
			<version>${revision}</version>
			<optional>true</optional>
		</dependency>
		<!-- The traffic view reads whichever RouteMetricsSource is active: the local meter
		     registry by default, a consolidating one when a provider module is added. -->
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-metrics-core</artifactId>
			<version>${revision}</version>
		</dependency>
		<!-- Optional: the shell contributes its own security filter chain when the
		     application secures the gateway with Spring Security. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-config</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-web</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Optional: the login page offers a button per identity provider, and the console
		     accepts the session an OpenID Connect provider issued. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-client</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- Optional: the endpoints of the console also accept a Bearer token. -->
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-resource-server</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-oauth2-jose</artifactId>
			<optional>true</optional>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			The module depends on Spring Security itself, not on the starter that
			auto-configures it. The tests need that auto-configuration: without it there is no
			ServerHttpSecurity to build the chain of the console from, and the chain the tests
			exercise would never be contributed.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
			<scope>test</scope>
		</dependency>
		<!--
			The OpenAPI view activates on a class name of the hub plugin. Depending on it in
			test scope keeps that condition honest: a renamed class breaks the test, not the
			application.
		-->
		<dependency>
			<groupId>ch.nexsol-tech.gateway</groupId>
			<artifactId>spring-cloud-gateway-hub-openapi</artifactId>
			<version>${revision}</version>
			<scope>test</scope>
		</dependency>
		<!--
			The gateway brings spring-boot-micrometer-observation, which switches on the WebFlux
			observation auto-configuration; introspecting it needs the metrics module. A real
			gateway application gets it through its own actuator or metrics starter.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-micrometer-metrics</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-webtestclient</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>io.projectreactor</groupId>
			<artifactId>reactor-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-configuration-processor</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>
	<build>
		<plugins>
			<plugin>
				<groupId>io.spring.javaformat</groupId>
				<artifactId>spring-javaformat-maven-plugin</artifactId>
				<version>${spring-javaformat-maven-plugin.version}</version>
				<executions>
					<execution>
						<phase>validate</phase>
						<inherited>true</inherited>
						<goals>
							<goal>validate</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
